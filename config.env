# ==============================================================================
#  config.env  -  THE ONLY FILE YOU EDIT FOR SITE-SPECIFIC VALUES.
#  (CPU/RAM/replicas/disk sizing lives in values/*.tmpl and zalando/charts/*/values.yaml - see DEPLOY.md "Sizing".)
#  Every line must be filled. `airgap/deploy-all.sh check` refuses to run while any REPLACE_ is left.
# ==============================================================================

# --- release identity (from CI / the release you were given) -------------------
export TF_TAG="0.17.7-73caf32"            # tf-* image tag = <chart version>-<shortsha> (chart 0.17.7, branch stage); same tag Xailon runs
export BRAND_TAG="0.17.0-etisalat-6b27a33" # Etisalat web images tag. 0.17.0-etisalat-6b27a33 is the ONLY etisalat-branded web build in GHCR (checked 10 Nov 2026);
                                           # when a 0.17.7-etisalat-<sha> build exists, set it here and rebuild the bundle

# --- chart source (private repo; fetched on the Mac by airgap/00-fetch-chart.sh, pinned to ONE commit so every build is reproducible) ---
export CHART_REPO="git@github.com:Infinia-Technology/ai-gateway-platform.git"
export CHART_REF="58577e2d2bd5b051745e741aa48a882462360e4d"   # branch `stage`: the 0.17.7 patch re-cut that pins the image tag 0.17.7-73caf32 (#980). Bump it together with TF_TAG when moving to a newer release.

# --- images: NO registry. Images are loaded from tar files straight into every node's containerd. ---
# IMAGE_MODE=tar      : no registry. Tars are loaded into every node; REGISTRY is only a NAME PREFIX (keep the default).
# IMAGE_MODE=registry : you have an internal registry. `deploy-all.sh images` PUSHES the tars into it and nodes PULL from it.
#                       Then set REGISTRY to the real address as host[:port][/project] (Harbor: "harbor.etisalat.com/tokenfactory"),
#                       and REGISTRY_USER / REGISTRY_PASS (pull secret `registry-pull` is created from them).
export IMAGE_MODE="tar"
export REGISTRY="registry.etisalat.local"
export REGISTRY_USER=""
export REGISTRY_PASS=""
export DEST_TLS_VERIFY="true"                             # only used by the optional registry scripts (02/02a)
# ---- HOW THE IMAGES REACH THE NODES (phase `images`) ---------------------------------------------------------------------------------------------------------------
# The cluster has no internet and no registry, so the 56 image tars of bundle/tars are copied to every node and imported into its containerd.
#   NODE_LOAD_MODE="ssh"  (USE THIS for Etisalat): for each node in NODES this VM runs `scp` (copy the tars to /tmp/etisalat-tars) and `ssh` + `sudo ctr -n k8s.io images import`
#                         (each tar is deleted after its import). Needs NO container image and NO registry. Safe to re-run: images already on the node are skipped ("present ...").
#   NODE_LOAD_MODE="pod"  : AKS LAB ONLY. A privileged helper pod per node does the import, but its own image (LOADER_DEBUG_IMAGE) must be pullable, which only works on the lab
#                         (AKS pulls it through the ACR cache of MCR). On the Etisalat VMs nothing can pull it: do not use.
# What you must prepare for "ssh" BEFORE `deploy-all.sh all` (DEPLOY.md B3 has the exact commands; `deploy-all.sh check` fails early if NODES is empty or still has REPLACE_):
#   1. NODES below = "<ssh-user>@<ip>" of every node that RUNS pods. Replace REPLACE_ssh-user with the real user (one user, the same on all nodes).
#      Etisalat: workers ed-kca-inf-tf-cpu-wrk-001..004 = 172.22.100.24 .25 .26 .27 (listed). The control nodes ed-kca-inf-tf-cn-01/02/03 = 172.22.100.21 .22 .23 run no application pods: leave them out
#      (add them only if `kubectl get nodes` + `describe node` show they accept normal pods, i.e. no NoSchedule taint).
#   2. Key login from THIS VM to every node, no password prompt:   ssh-copy-id <ssh-user>@<ip>
#   3. That user has passwordless sudo on every node:               ssh <ssh-user>@<ip> 'sudo -n true && echo sudo-ok'
#   4. containerd's CLI `ctr` exists on every node:                 ssh <ssh-user>@<ip> 'which ctr'      (RKE2/k3s keep it in another path: then tell us, the script needs a small change)
#   5. About 6 GB free in /tmp on every node (the largest tars are copied one after the other and removed):   ssh <ssh-user>@<ip> 'df -h /tmp'
#   6. This VM can reach port 22 of every node (firewall).
# Check it worked, on any worker:  sudo ctr -n k8s.io images ls -q | grep -c registry.etisalat.local     (56 or more: digest-pinned images are listed twice)
# A NEW node later (scale-out): add it to NODES and run `airgap/deploy-all.sh images`; Kubernetes cannot start any pod on it before its images are imported.
export NODE_LOAD_MODE="ssh"
export NODES="REPLACE_ssh-user@172.22.100.24 REPLACE_ssh-user@172.22.100.25 REPLACE_ssh-user@172.22.100.26 REPLACE_ssh-user@172.22.100.27"
export LOADER_DEBUG_IMAGE="mcr.microsoft.com/azurelinux/busybox:1.36"   # pod mode only (AKS lab): ignored when NODE_LOAD_MODE="ssh"
export LOADER_HTTP_PORT="8000"                                           # pod mode only: ignored when NODE_LOAD_MODE="ssh"

# --- cluster -------------------------------------------------------------------
export KUBECONFIG_FILE="$HOME/etisalat.kubeconfig"        # every kubectl/helm call of the scripts uses THIS file (no --kubeconfig typing)
export NAMESPACE="tokenfactory"                  # app + Postgres namespace
export SINGLE_NODE="no"                                   # "yes" ONLY for a 1-node lab: Postgres runs 1 instance instead of 3, node-count check skipped
export LB_INTERNAL="no"                                   # "yes" for Azure/AKS: LoadBalancer Services get private IPs only (only used when EXPOSE=loadbalancer)
# --- Ingress controller (portal/admin/www/auth) -----------------------------------------------------------------------------------
# existing = the cluster ALREADY runs an Ingress-NGINX controller (Etisalat: on MetalLB 172.22.100.241): this package installs none and only
#            creates the Ingress object for INGRESS_CLASS. `check` stops if that IngressClass does not exist.
# install  = this package installs the F5 NGINX Ingress Controller 3.6.2 (namespace nginx-ingress). Do not do both on one cluster: two controllers with one class fight.
export INGRESS_CONTROLLER="existing"
export INGRESS_CLASS="nginx"                              # find it with: kubectl get ingressclass
# Envoy (api.) LoadBalancer IP, only with EXPOSE="loadbalancer" and a LB such as MetalLB (Etisalat pool 172.22.100.241-250; .241 is the ingress controller). Empty = the LB picks one.
export ENVOY_LB_IP="172.22.100.242"   # fixed IP for api. (free IP of the MetalLB pool; .241 is the existing Ingress-NGINX)
export EXPOSE="loadbalancer"   # MetalLB direct: Envoy (api.) gets a LoadBalancer IP from the pool 172.22.100.241-250 (no Cloudflare tunnel)
export BEHIND_CLOUDFLARE="no"   # no Cloudflare: Envoy (api.) terminates TLS itself with TLS_CERT/TLS_KEY (the certificate must also cover api.<DOMAIN>, e.g. a wildcard)
# --- Secrets ---------------------------------------------------------------------------------------------------------------------
# vault      = a DEDICATED HashiCorp Vault runs inside THIS cluster (namespace VAULT_NAMESPACE), exactly like tokenfactory-prod / tf-stage: the Vault CSI provider and the
#              Secrets Store CSI driver sync the keys into Secret tokenfactory-secrets (phase `vault`, `secrets`; guide: VAULT-SECRETS.md). Nothing leaves the cluster.
# kubernetes = no Vault: the package creates Secret tokenfactory-secrets directly with random values
export SECRETS_BACKEND="vault"
export VAULT_NAMESPACE="vault"
export VAULT_STORAGE_SIZE="10Gi"                          # PVC of the Vault pod (file storage), on STORAGE_CLASS
export VAULT_INIT_FILE="$HOME/.etisalat-vault-init.json"  # unseal keys + root token written by `vault operator init` (mode 0600). COPY IT OFFLINE: without it Vault cannot be unsealed
export VAULT_UI="true"                                    # "true" = open the Vault web UI (unseal, browse, edit secrets) on VAULT_HOST through the cluster's Ingress-NGINX with TLS + IP allowlist; "false" = no UI/ingress (Vault reachable only with kubectl exec)
export VAULT_HOST=""                                       # empty = vault.<DOMAIN>. DNS: that name -> 172.22.100.241 (the ingress controller); the TLS certificate must cover it (a wildcard *.<DOMAIN> does)
export VAULT_UI_ALLOW="172.22.100.0/22"                   # networks allowed to open the UI (comma separated CIDRs). Keep it small: Vault holds every secret

# --- Storage -------------------------------------------------------------------------------------------------------------------
# hpe-x10000 = this package installs the HPE CSI Driver 3.2.0 (Alletra Storage MP X10000, NFSv4.1) and creates the StorageClass STORAGE_CLASS (phase `storage`; guide: STORAGE-HPE-CSI.md)
# existing   = STORAGE_CLASS already exists in the cluster: nothing is installed, `check` only verifies it
export STORAGE_BACKEND="hpe-x10000"
export STORAGE_CLASS="hpe-standard-file"                  # the class every PVC uses (Postgres, Redis, MinIO, Kafka, ClickHouse); with hpe-x10000 it is created by this package
export X10000_MGMT="REPLACE_x10000-management-ip-or-fqdn"         # X10000 management address (port 443 is added when you give no port)
export X10000_CLIENT_ID="REPLACE_x10000-csp-client-id"            # client ID of the CSP API client the storage admin created (glsctl describe extoauthclient hpe-csi-driver)
# The client SECRET is NOT written here. Before running the `storage` phase: read -rs X10000_CLIENT_SECRET; export X10000_CLIENT_SECRET
export X10000_ACL="172.22.100.24,172.22.100.25,172.22.100.26,172.22.100.27"   # clients allowed to mount the NFS exports: the 4 workers (IPs, CIDRs or names)
export X10000_ALLOW_EXPANSION="false"                     # "true" only after the storage team confirms the X10000 CSP can expand volumes
export PLATFORM="linux/amd64"                             # node CPU architecture of the images to mirror

# --- DNS names / TLS -----------------------------------------------------------
export DOMAIN="REPLACE_etisalat.example"                  # DNS: portal./admin./www./auth.<DOMAIN> -> 172.22.100.241 (ingress), api.<DOMAIN> -> ENVOY_LB_IP
export SUPPORT_EMAIL="support@iamsaif.ai"                 # as tokenfactory-prod: the sender VERIFIED at Resend (change only if Resend verified another address)
export PLATFORM_ADMIN_EMAIL=""                             # empty = admin@<DOMAIN>: the bootstrap super-admin login
# TLS certificate for the INGRESS (portal/admin/www/auth), as in the Xailon overlay: the cert and key you have become the TLS Secret
# `INGRESS_TLS_SECRET` in the app namespace and the Ingress gets a `tls:` block that uses it (ports 80 AND 443 both work; no redirect
# when BEHIND_CLOUDFLARE=yes, so cloudflared may use http://...:80 or https://...:443).
export INGRESS_TLS="yes"                                  # MUST stay yes: the Ingress is always deployed with TLS from the cert below (the chart refuses a plain-HTTP Ingress)
export INGRESS_TLS_SECRET="tf-etisalat-ingress-tls"
export TLS_CERT="REPLACE_/path/to/etisalat.crt"           # PEM (+ chain); must cover portal./admin./www./auth.<DOMAIN> (wildcard or SANs)
export TLS_KEY="REPLACE_/path/to/etisalat.key"            # PEM private key

# --- mail: the SAME as tokenfactory-prod (Resend) -------------------------------------------------------------------------
# NOTE: smtp.resend.com is on the Internet. The Keycloak and tf-accounts pods need OUTBOUND tcp/465 to smtp.resend.com
# (and https to api.resend.com), otherwise sign-up / OTP / reset mails are not delivered. Allow it on the firewall, or put an
# internal relay here instead (then set SMTP_PORT/SMTP_SSL/SMTP_STARTTLS to what that relay speaks).
export SMTP_HOST="smtp.resend.com"
export SMTP_PORT="465"
export SMTP_USER="resend"
export SMTP_SSL="true"
export SMTP_STARTTLS="false"
export SMTP_PASSWORD=""                                   # REQUIRED for Resend: the Resend API key (stored as `smtp-password` in tokenfactory-secrets; same value as in Vault for prod)
# ---- xailon-tf-prod app settings (optional) ----
# yes = also apply the live xailon-tf-prod app config (values/xailon-integrations.yaml): Persona CDD with enforced sign-up verification, Zendesk, Google/Microsoft login ids, PKCE.
# They call external services: in an air-gap they cannot work, and enforceNewSignups would block new sign-ups. Replicas, Keycloak HA, Postgres, ledger HA already follow xailon-tf-prod.
export XAILON_INTEGRATIONS="no"

# ---- SECRET VALUES (the 30 keys of tokenfactory-secrets) ----
# Real values never go in this file (it is committed to git). They live in the git-ignored file below; the `secrets` phase reads it and writes them to Vault.
# To change ANY secret: edit that file (KEY=VALUE per line, keys listed in secrets.local.env.example) BEFORE the first `secrets` run. Keys not listed there stay random.
# Already-created Vault secret is never overwritten: to change one later use `vault kv patch` (VAULT-SECRETS.md section 4).
export SECRETS_FILE="$ROOT/secrets.local.env"

# --- Keycloak SPI jar (keycloak-2fa-email-authenticator, the same jar tokenfactory-prod / Xailon use) ------------------------
# Empty (recommended) = the installer hosts the jar INSIDE the cluster (ConfigMap + 2 tiny pods, Service `keycloak-spi`) from bundle/jars/.
# Set a URL only if you prefer your own internal web server that serves that jar (the pods must reach it).
# Leave it EMPTY in the air-gap. (tokenfactory-prod / Xailon use the Maven Central URL
#   https://repo1.maven.org/maven2/io/github/mesutpiskin/keycloak-2fa-email-authenticator/26.5.0-KC26.7.3/keycloak-2fa-email-authenticator-26.5.0-KC26.7.3.jar
# which only works WITH internet — do not put it here for Etisalat: the pods could not download it. It is the same jar that is in bundle/jars/.)
export KEYCLOAK_JAR_URL=""

# --- ClickHouse disk (upstream OpenMeter chart hardcodes 3Gi/1Gi; deploy-all patches it from these) ---
export CH_DATA_SIZE="50Gi"
export CH_LOG_SIZE="5Gi"

# --- docs site (tf-docs-web) -----------------------------------------------------------------
# The Etisalat-branded tf-docs-web image has NOT been built yet (only the default-brand one exists), so docs stay OFF.
# Effect while "no": the public site's /docs pages return an error; nothing else is affected. Set "yes" once an
# `0.17.x-etisalat-<sha>` tf-docs-web exists, add it back to airgap/images.txt, and rebuild the bundle.
export DOCS_WEB="no"

# --- Postgres operator --------------------------------------------------------------
# install  = this package installs Zalando postgres-operator v1.14.0 (cluster has none)       <- default
# existing = the cluster ALREADY runs a Zalando operator (e.g. installed from the upstream chart): skip it, only create `pgdb`.
#            Then make sure that operator watches namespace $NAMESPACE and its spilo image is mirrored; two operators on one cluster fight.
export PG_OPERATOR_MODE="install"

# --- SIZING & HA  (defaults = the LIVE xailon-tf-prod values, read from the cluster on 10 Nov 2026; change here, nothing else needs editing) -----------
# Envoy (the API data plane takes all the inference load): NO CPU/RAM requests or limits on purpose (as Xailon / prod), at least 6 pods.
export ENVOY_REPLICAS="6"
export ENVOY_PDB_MIN_AVAILABLE="1"
# Keycloak HA (3 pods, Infinispan cluster, one pod per node). Xailon: memory only, 1Gi request / 2Gi limit, heap -Xmx2g.
export KEYCLOAK_REPLICAS="3"
export KEYCLOAK_MEM_REQUEST="1Gi"
export KEYCLOAK_MEM_LIMIT="2Gi"
export KEYCLOAK_HEAP="-Xms512m -Xmx2g -XX:+UseContainerSupport"      # keep Xmx at or below the memory limit
export KEYCLOAK_ANTIAFFINITY="required"                              # required = never two Keycloak pods on one node (as Xailon; needs >= 3 schedulable nodes) | preferred (forced when SINGLE_NODE=yes)
# Postgres HA (Zalando pgdb, external for the app). Xailon uses Azure Postgres 16; Zalando runs the same major version. PG_INSTANCES is forced to 1 when SINGLE_NODE=yes.
export PG_VERSION="16"
export PG_INSTANCES="3"
export PG_VOLUME_SIZE="20Gi"
export PG_CPU_REQUEST="1"
export PG_MEM_REQUEST="2Gi"
export PG_CPU_LIMIT="4"
export PG_MEM_LIMIT="8Gi"
export PG_MAX_CONNECTIONS="300"
# tf-* services, one line each:  "<replicas> <cpu-request> <mem-request> <cpu-limit> <mem-limit>"
#   "-" in a position leaves that value out;  "<replicas> none"  = no requests and no limits at all (what Xailon runs for most services).
# These are the xailon-tf-prod live values. tf-ledger runs 3 pods with leader election (chart >= 0.17.4; use "1 none" on a single-node lab).
export SVC_TF_ACCOUNTS="3 50m 64Mi 200m 256Mi"
export SVC_TF_ADMIN_WEB="3 none"
export SVC_TF_AUTH="3 none"
export SVC_TF_BABEL="3 25m 32Mi 300m 256Mi"
export SVC_TF_CONTROL="3 none"
export SVC_TF_DOCS_WEB="1 50m 96Mi 300m 256Mi"
export SVC_TF_LEDGER="3 none"
export SVC_TF_OPS="3 20m 48Mi 250m 128Mi"
export SVC_TF_PORTAL_WEB="3 50m 32Mi 200m 1Gi"
export SVC_TF_RELAY="3 none"
export SVC_TF_SHIM="3 25m 256Mi 1 1Gi"
export SVC_TF_SITE_WEB="1 50m 64Mi 300m 256Mi"
export SVC_TF_WARDEN="3 none"
# Single-instance infra (resources only), "<cpu-request> <mem-request> <cpu-limit> <mem-limit>"; "-" leaves a value out
export RES_OPENFGA="- 64Mi - 256Mi"
export RES_MINIO="50m 128Mi 300m 512Mi"
export RES_REDIS="100m 1Gi 1 4Gi"
# Redis HA (like Keycloak and Postgres). sentinel = StatefulSet of 3 pods (redis + sentinel each, PVC per pod), automatic failover in ~1-7 s, password required (tokenfactory-secrets key redis-password).
# standalone = one pod, no HA (an outage while it restarts). Needs the tf-* images >= 0.17.6. FRESH installs only: moving a live standalone Redis to sentinel needs the adopt migration (docs/runbooks/redis-ha.md section 5).
# RES_REDIS above is PER POD, REDIS_PVC_SIZE is per pod; placement: one pod per node (hard anti-affinity) unless SINGLE_NODE=yes (then soft).
export REDIS_ARCH="sentinel"                               # sentinel | standalone
export REDIS_MAXMEMORY="3gb"                               # as xailon-tf-prod (keep it below the memory limit in RES_REDIS)
export REDIS_PVC_SIZE="10Gi"                               # as xailon-tf-prod
# Ingress for portal/admin/www/auth (the Envoy Gateway serves api.<DOMAIN> only)
export INGRESS_ENABLED="true"

# --- ANY OTHER VALUE for the TokenFactory release, still without touching a template ---------------------------------------
# Raw YAML, applied as the LAST values layer (it wins over everything except the service keys). Put only what you change.
# Replicas and CPU/RAM of every service are the SVC_* / RES_* lines above; use this only for what has no variable. Example (keep the 2-space indentation) (uncomment, keep the 2-space indentation):
#   export CUSTOM_VALUES_YAML='
#   tf-relay:
#     replicas: 4
#     resources:
#       requests: { cpu: 100m, memory: 512Mi }
#       limits:   { cpu: 2000m, memory: 2Gi }
#   ingress:
#     annotations:
#       nginx.org/client-max-body-size: 256m
#   '
# (Helm replaces lists whole, e.g. tf-ledger.env: copy the entire list from values-tf-etisalat.yaml, then edit one line.)
export CUSTOM_VALUES_YAML=""
