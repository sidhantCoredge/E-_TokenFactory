# ==============================================================================
#  config.env  -  THE ONLY FILE YOU EDIT FOR SITE-SPECIFIC VALUES.
#  (CPU/RAM/replicas/disk sizing lives in values/*.tmpl and zalando/charts/*/values.yaml - see DEPLOY.md "Sizing".)
#  Every line must be filled. `airgap/deploy-all.sh check` refuses to run while any REPLACE_ is left.
# ==============================================================================

# --- release identity (from CI / the release you were given) -------------------
export TF_TAG="REPLACE_0.17.2-shortsha"            # tf-* image tag,  e.g. 0.17.2-356be61
export BRAND_TAG="REPLACE_0.17.x-etisalat-shortsha" # Etisalat web images tag, e.g. 0.17.2-etisalat-ab12cd3

# --- images: NO registry. Images are loaded from tar files straight into every node's containerd. ---
# REGISTRY is only a NAME PREFIX baked into image names (nothing is ever pulled from it). Keep the default.
export REGISTRY="registry.etisalat.local"
export REGISTRY_USER=""
export REGISTRY_PASS=""
export DEST_TLS_VERIFY="true"                             # only used by the optional registry scripts (02/02a)
export NODE_LOAD_MODE="pod"                               # pod = load via a privileged pod (no SSH needed, e.g. AKS lab);  ssh = scp+ssh to the nodes
export NODES=""                                           # ssh mode only: "user@10.0.0.11 user@10.0.0.12 ..."
export LOADER_DEBUG_IMAGE="mcr.microsoft.com/azurelinux/busybox:1.36"   # pod mode only: any image already on the node that has /bin/sh + chroot
export LOADER_HTTP_PORT="8000"

# --- cluster -------------------------------------------------------------------
export KUBECONFIG_FILE="$HOME/etisalat.kubeconfig"        # every kubectl/helm call of the scripts uses THIS file (no --kubeconfig typing)
export NAMESPACE="tokenfactory-etisalat"                  # app + Postgres namespace
export SINGLE_NODE="no"                                   # "yes" ONLY for a 1-node lab: Postgres runs 1 instance instead of 3, node-count check skipped
export LB_INTERNAL="no"                                   # "yes" for Azure/AKS: LoadBalancer Services get private IPs only
export STORAGE_CLASS="REPLACE_storageclass-name"          # must exist and allow volume expansion
export PLATFORM="linux/amd64"                             # node CPU architecture of the images to mirror

# --- DNS names / TLS -----------------------------------------------------------
export DOMAIN="REPLACE_etisalat.example"                  # creates api./auth./portal./admin./www.<DOMAIN>
export SUPPORT_EMAIL="support@${DOMAIN}"                  # must be an address your SMTP relay accepts as sender
export PLATFORM_ADMIN_EMAIL="admin@${DOMAIN}"
export TLS_CERT="REPLACE_/path/to/wildcard.crt"           # PEM, wildcard *.<DOMAIN> (+ chain)
export TLS_KEY="REPLACE_/path/to/wildcard.key"

# --- mail (internal relay reachable from the cluster) ---------------------------
export SMTP_HOST="REPLACE_smtp.etisalat.local"
export SMTP_PORT="587"
export SMTP_USER="REPLACE_smtp-user"                      # may be any string if the relay is unauthenticated
export SMTP_PASSWORD=""                                   # empty allowed

# --- Keycloak SPI jar: URL where YOU host bundle/jars/keycloak-2fa-email-authenticator-*.jar ---
export KEYCLOAK_JAR_URL="REPLACE_https://artifacts.etisalat.local/keycloak-2fa-email-authenticator-26.5.0-KC26.7.3.jar"

# --- ClickHouse disk (upstream OpenMeter chart hardcodes 3Gi/1Gi; deploy-all patches it from these) ---
export CH_DATA_SIZE="50Gi"
export CH_LOG_SIZE="5Gi"

# --- Postgres operator --------------------------------------------------------------
# install  = this package installs Zalando postgres-operator v1.14.0 (cluster has none)       <- default
# existing = the cluster ALREADY runs a Zalando operator (e.g. installed from the upstream chart): skip it, only create `pgdb`.
#            Then make sure that operator watches namespace $NAMESPACE and its spilo image is mirrored; two operators on one cluster fight.
export PG_OPERATOR_MODE="install"
