# Secrets Store CSI driver (chart secrets-store-csi-driver 1.5.6). Placeholders come from config.env.
syncSecret: { enabled: true }             # REQUIRED: lets the driver copy the Vault values into a Kubernetes Secret (tokenfactory-secrets)
enableSecretRotation: true                # a changed Vault value reaches the Secret without a redeploy
rotationPollInterval: 2m
linux:
  image: { repository: "${REGISTRY}/csi-secrets-store/driver", tag: v1.5.6 }
  crds: { image: { repository: "${REGISTRY}/csi-secrets-store/driver-crds", tag: v1.5.6 } }
  registrarImage: { repository: "${REGISTRY}/sig-storage/csi-node-driver-registrar", tag: v2.13.0 }
  livenessProbeImage: { repository: "${REGISTRY}/sig-storage/livenessprobe", tag: v2.15.0 }
